# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
build*
*apk

# Environment files (prevent accidental API key leaks)
.env
.env.*
!.env.example

# Fastlane (iOS/Android deployment logs and keys)
fastlane/report.xml
fastlane/Preview.html
fastlane/readme.md

# Xcode/iOS local user settings
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
*.xcworkspace/*
!*.xcworkspace/contents.xcworkmapped
Pods/

# Gradle & Android caches
.gradle/
local.properties

# Bundles & Logs
*.jsbundle
*.log

# Editor directories
.vscode/
.idea/
